APP_NAME="Tasks for Today"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite when DB_DATABASE is omitted.
# For MySQL, uncomment these and change DB_CONNECTION to mysql:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tasks_today_tsa3
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single
DEVELOPER_NAME="John"
DEVELOPER_SECTION="Not specified"
